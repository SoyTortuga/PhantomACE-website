node_modules/
.dev.vars
.wrangler/

# Self-hosted server secrets (Twitch credentials, EventSub HMAC secret,
# bot service secret, Postgres connection string). Template lives at
# server/.env.example.
server/.env
.DS_Store
Thumbs.db
*.log

# Internal-only docs (setup guides, checklists, roster notes) — not for
# the public repo.
_private/

# Purchased asset packs (pack-forge / Game Paradise) are NOT tracked.
# Their licence permits shipping them inside the game but forbids redistributing
# them "as assets" — and this repo is public, so committing them would do exactly
# that. They reach production through `npm run deploy`, which uploads the local
# directory to Cloudflare Pages directly rather than building from git.
# Regenerate derived sprites with games/dino-park/_build-*.js.
games/dino-park/assets/dino-assets/
# Skull Clicker building sprites, spliced from the same purchased packs.
games/skull-clicker/assets/buildings/
# Raid-boss source art (aseprite + raw sheets). The flattened strips the game
# actually loads live in games/skull-clicker/assets/raid/ and ARE tracked.
games/skull-clicker/assets/Undead executioner/
# Mana Clash co-op enemy + background art (licensed itch.io packs). Normalized
# strips the game loads; gitignored like dino-assets, copied to the rig.
games/mana-clash/assets/enemies/
games/mana-clash/assets/backgrounds/
# Same licensed source, effect sprites for the ultimate. The flattened
# strip the game actually loads is games/mana-clash/assets/fx/ (also
# ignored, same as the enemies/backgrounds art above).
games/mana-clash/assets/fx/
games/mana-clash/assets/Unholy Ground/

# Scratch output from asset extraction runs
_tile_*.png
_test_*.png
_fence_crop.png
_vfence-*.png
games/dino-park/assets/dino-assets/_*.png
PhantomACE-Demo.zip

# Database dumps. They contain every player's data and must never be
# committed; backup-db.ps1 writes to C:\PhantomACE-Backups, outside the repo,
# but this catches a stray one written here by hand.
*.dump
*.ndjson

# Python bytecode from tools/ (the atlas builder)
__pycache__/
