# ══════════════════════════════════════════════
# PhantomACE self-hosted server config
#
# Copy to `server/.env` and fill in. `.env` is gitignored —
# never commit real values.
#
# The five TWITCH_*/BOT_* secrets below are the same ones
# currently set as encrypted secrets on the Cloudflare Pages
# project. Cloudflare cannot show them back to you, so they
# must come from wherever they were originally recorded.
# ══════════════════════════════════════════════

# ── Where this server listens (localhost only; the Cloudflare
#    Tunnel is the sole public ingress) ──────────────────────
PORT=8789

# ── The public origin this server is reached at. ────────────
# CRITICAL: this is load-bearing, not cosmetic. Node's req.url is
# path-only and req.headers.host is localhost behind the tunnel, so
# the request adapter builds `new Request(PUBLIC_ORIGIN + req.url)`.
# Everything below depends on it being exactly right:
#   - the Twitch OAuth redirect_uri (Twitch requires an EXACT match
#     against a registered URI, or login fails outright)
#   - every EventSub callback URL registered via /api/admin/bot-setup
#   - post-login return_to redirects
#   - the session cookie's Secure flag (set only when protocol is https)
# No trailing slash.
#   dev:  https://dev.phantomace.tv
#   prod: https://phantomace.tv
PUBLIC_ORIGIN=https://dev.phantomace.tv

# ── Postgres ───────────────────────────────────────────────
# Use the *_dev database while building; switch to phantomace-tv
# only at cutover.
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/phantomace-tv-dev

# ── Twitch application (site login + Helix calls) ──────────
# Client ID is not sensitive; the secret is.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Twitch EventSub webhook HMAC secret ────────────────────
# The server refuses to boot without this. Historically the code
# skipped signature verification when it was absent, which would
# let anyone POST forged Twitch events to an internet-facing box.
TWITCH_EVENTSUB_SECRET=

# ── The broadcaster's numeric Twitch user ID ───────────────
# Used for EventSub conditions, chat-send target, and the
# authorized-sender check on chat commands.
TWITCH_BROADCASTER_ID=

# ── Shared secret for the always-on bot service ────────────
# Must match BOT_SERVICE_SECRET in PhantomACE-Bot-Service/.env.
# Checked against the X-Bot-Service-Secret header on /api/bot/bridge.
BOT_SERVICE_SECRET=

# ── Optional bot fallbacks ─────────────────────────────────
# Normally unset: both are written to storage automatically once
# the /api/admin/bot-setup OAuth flow completes. Only set these to
# override what's in the database.
TWITCH_BOT_USER_ID=
TWITCH_BOT_REFRESH_TOKEN=

# Signs the pham_session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The server REFUSES TO START without it, deliberately: with no secret,
# no session could be verified and every request — including the
# broadcaster's — would arrive looking logged out, with no visible reason.
#
# Changing this value invalidates every existing session at once, which is
# also how you force a global logout if one is ever needed.
SESSION_SECRET=
